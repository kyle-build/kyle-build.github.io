<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><% if (page.title) { %><%= page.title %> · <% } %><%= config.title %></title>
  <meta name="description" content="<%= page.description || config.description %>">
  <link rel="icon" href="<%= url_for('/images/favicon.svg') %>" type="image/svg+xml">
  <link rel="stylesheet" href="<%= url_for('/css/style.css') %>">
</head>
<body class="<%= is_home() ? 'is-home' : 'is-doc' %>">
  <%- partial('_partial/header') %>
  <div class="shell">
    <div class="sidebar-backdrop"></div>
    <%- partial('_partial/sidebar') %>
    <main class="main">
      <%- body %>
    </main>
  </div>
  <button class="to-top" type="button" aria-label="回到顶部">↑</button>
  <script src="<%= url_for('/js/main.js') %>"></script>
</body>
</html>
