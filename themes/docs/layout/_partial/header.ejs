<%
  function norm(p) {
    p = String(p || '/').replace(/index\.html$/, '');
    if (p.charAt(0) !== '/') p = '/' + p;
    if (p === '/index/' || p === '/index') return '/';
    if (p.length > 1 && p.slice(-1) !== '/') p += '/';
    return p;
  }
  var current = page.path === 'index.html' ? '/' : norm(page.path);
  var activeSlug = 'home';
  var github = 'https://github.com/kyle-build';
  if (current.indexOf('/interview/') === 0) {
    activeSlug = 'interview';
    github = 'https://github.com/kyle-build/interview-code-base';
  }
  (site.data.tracks || []).forEach(function(track) {
    if (current.indexOf('/learning/' + track.slug + '/') === 0) {
      activeSlug = track.slug;
      github = 'https://github.com/kyle-build/' + track.repo;
    }
  });
  if (page.categories) {
    page.categories.each(function(cat) {
      (site.data.tracks || []).forEach(function(track) {
        if (track.title === cat.name) {
          activeSlug = track.slug;
          github = 'https://github.com/kyle-build/' + track.repo;
        }
      });
      if (cat.name === 'Interview') {
        activeSlug = 'interview';
        github = 'https://github.com/kyle-build/interview-code-base';
      }
    });
  }
%>
<header class="top">
  <a class="brand" href="<%= url_for('/') %>">Kyle</a>
  <button class="nav-toggle" type="button" aria-label="打开目录">目录</button>
  <nav class="menu-links">
    <% (site.data.nav || []).forEach(function(item) { %>
      <a href="<%= url_for(item.path) %>" class="<%= item.slug === activeSlug ? 'is-active' : '' %>"><%= item.title %></a>
    <% }) %>
  </nav>
  <div class="top-actions">
    <form class="search" action="<%= url_for('/') %>" method="get" role="search">
      <input id="search-input" type="search" placeholder="Search" autocomplete="off">
      <div id="search-result" class="search-result" hidden></div>
    </form>
    <a class="github" href="<%= github %>" target="_blank" rel="noopener" aria-label="GitHub">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path fill="currentColor" d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.1c-3.3.7-4-1.6-4-1.6-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.7-2.8 5.7-5.5 6 .4.3.8 1 .8 2.1v3.1c0 .3.2.7.8.6A12 12 0 0 0 12 .3z"/>
      </svg>
    </a>
  </div>
</header>
