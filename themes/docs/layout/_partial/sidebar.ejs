<%
  function norm(p) {
    p = String(p || '/').replace(/index\.html$/, '');
    if (p.charAt(0) !== '/') p = '/' + p;
    if (p === '/index/' || p === '/index') return '/';
    if (p.length > 1 && p.slice(-1) !== '/') p += '/';
    return p;
  }
  function notesFor(title) {
    var notes = [];
    site.posts.sort('date').each(function(post) {
      var hit = false;
      post.categories.each(function(cat) { if (cat.name === title) hit = true; });
      if (hit) notes.push(post);
    });
    return notes;
  }
  var current = page.path === 'index.html' ? '/' : norm(page.path);
  var isHome = current === '/';
  var isInterview = current.indexOf('/interview/') === 0;
  var track = null;
  (site.data.tracks || []).forEach(function(item) {
    if (current.indexOf('/learning/' + item.slug + '/') === 0) track = item;
  });
  if (!track && page.categories) {
    page.categories.each(function(cat) {
      (site.data.tracks || []).forEach(function(item) {
        if (item.title === cat.name) track = item;
      });
    });
  }
%>
<aside class="sidebar">
  <% if (isHome) { %>
    <p class="sidebar-title">全部模块</p>
    <ul>
      <li><a href="#learning">学习笔记</a></li>
      <li><a href="#interview">面试</a></li>
      <% (site.data.tracks || []).forEach(function(item) { %>
        <li><a href="#<%= item.slug %>"><%= item.title %></a></li>
      <% }) %>
    </ul>
  <% } else if (isInterview) { %>
    <p class="sidebar-title">Interview</p>
    <ul>
      <li>
        <a class="<%= current === '/interview/' ? 'is-active' : '' %>" href="<%= url_for('/interview/') %>">总览</a>
      </li>
    </ul>
    <% ((site.data.interview && site.data.interview.groups) || []).forEach(function(group) { %>
      <p class="sidebar-group"><%= group.title %></p>
      <ul>
        <% (group.items || []).forEach(function(item) { %>
          <li>
            <a class="<%= current === norm(item.path) ? 'is-active' : '' %>" href="<%= url_for(item.path) %>"><%= item.title %></a>
          </li>
        <% }) %>
      </ul>
    <% }) %>
  <% } else if (track) { %>
    <p class="sidebar-title"><%= track.title %></p>
    <ul>
      <li>
        <a class="<%= current === norm('/learning/' + track.slug + '/') ? 'is-active' : '' %>" href="<%= url_for('/learning/' + track.slug + '/') %>">总览</a>
      </li>
    </ul>
    <% var notes = notesFor(track.title); %>
    <% if (notes.length) { %>
      <p class="sidebar-group">章节</p>
      <ul>
        <% notes.forEach(function(post) { %>
          <li>
            <a class="<%= current === norm(post.path) ? 'is-active' : '' %>" href="<%= url_for(post.path) %>"><%= post.title %></a>
          </li>
        <% }) %>
      </ul>
    <% } %>
  <% } else { %>
    <p class="sidebar-title">目录</p>
    <ul>
      <li><a href="<%= url_for('/') %>">返回首页</a></li>
    </ul>
  <% } %>
</aside>
