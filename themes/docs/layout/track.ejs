<% var track = null; (site.data.tracks || []).forEach(function(item) { if (item.slug === page.slug) track = item; }); %>
<article class="article">
  <div class="crumb"><%= track ? track.title : 'Learning' %> →</div>
  <h1><%= page.title %></h1>
  <% if (track) { %>
    <p class="lede"><%= track.summary %></p>
    <p><a class="ext" href="https://github.com/kyle-build/<%= track.repo %>" target="_blank" rel="noopener">GitHub 仓库</a></p>
  <% } %>
  <div class="prose">
    <%- page.content %>
    <% var notes = []; if (track) { site.posts.sort('date').each(function(post) {
      post.categories.each(function(cat) { if (cat.name === page.title) notes.push(post); });
    }); } %>
    <% if (notes.length) { %>
      <h2>章节</h2>
      <ul>
        <% notes.forEach(function(post) { %>
          <li><a href="<%= url_for(post.path) %>"><%= post.title %></a></li>
        <% }) %>
      </ul>
    <% } else { %>
      <p>章节会显示在左侧目录。新增一篇带对应 <code>categories</code> 的 Markdown 即可出现。</p>
    <% } %>
  </div>
</article>
