<article class="article">
  <div class="crumb">
    <% if (page.categories && page.categories.length) { %>
      <% page.categories.each(function(cat) { %>
        <%= cat.name %>
      <% }) %>
      →
    <% } %>
  </div>
  <h1><%= page.title %></h1>
  <div class="prose">
    <%- page.content %>
  </div>
</article>
