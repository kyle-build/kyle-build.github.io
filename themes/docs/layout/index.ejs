<section class="home-section" id="learning">
  <h2>学习笔记</h2>
  <div class="card-grid">
    <% (site.data.tracks || []).forEach(function(track) { %>
      <a class="topic-card" id="<%= track.slug %>" href="<%= url_for('/learning/' + track.slug + '/') %>">
        <h3><%= track.title %></h3>
        <p>
          <span class="topic-mark"><%= track.title.slice(0, 2) %></span>
          <span><%= track.summary %></span>
        </p>
      </a>
    <% }) %>
  </div>
</section>

<section class="home-section" id="interview">
  <h2>面试</h2>
  <div class="card-grid">
    <a class="topic-card" href="<%= url_for('/interview/') %>">
      <h3>Interview</h3>
      <p>
        <span class="topic-mark">面</span>
        <span>前端面试复习总览，目录和 interview-code-base 对齐。</span>
      </p>
    </a>
    <% ((site.data.interview && site.data.interview.groups) || []).forEach(function(group) { %>
      <% (group.items || []).forEach(function(item) { %>
        <a class="topic-card" href="<%= url_for(item.path) %>">
          <h3><%= item.title %></h3>
          <p>
            <span class="topic-mark"><%= group.title.slice(0, 1) %></span>
            <span><%= group.title %> · <%= item.title %></span>
          </p>
        </a>
      <% }) %>
    <% }) %>
  </div>
</section>
